# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL. Defaults match the local dev setup when these are left unset.
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=easy_gig

# Google Places API (New). Server-side only — do not put this key in HTML or public JS.
# Used by the app and by npm run seed. See docs/GOOGLE_PLACES.md
GOOGLE_PLACES_API_KEY=
